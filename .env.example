# Copy to .env and fill in what you have. With no keys the app runs in device-only mode.

# AI meal plans (server-side only; never prefix with VITE_)
ANTHROPIC_API_KEY=

# Accounts and cloud sync (public by design; row-level security protects the data)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Account deletion (server-side only; never prefix with VITE_)
SUPABASE_SECRET_KEY=

# Optional: AI plans each user may generate per rolling 7 days (default 3)
# DIET_PLANS_PER_WEEK=3
